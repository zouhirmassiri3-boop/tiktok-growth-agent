# Copy to ".env" and fill in. NEVER commit the real .env.
# The TikTok login for the dedicated automation Chrome profile.
TIKTOK_USERNAME=your_tiktok_username
TIKTOK_PASSWORD=your_tiktok_password

# Corenexis Image CDN key (image hosting). In this operator's setup it lives in a
# separate file; if you consolidate it here, keep this file gitignored.
CORENEXIS_API_KEY=your_corenexis_key
